<div class="table-wrap">
  <table>
    <tr><th>Record</th><th>Retracted</th><th>Why</th><th></th></tr>
    <% records.each do |r| %>
      <% tombstone = r.versions.find_by(version: r.version) %>
      <tr>
        <td><code><%= r.ref %></code></td>
        <td title="<%= r.retracted_at.utc.iso8601 %>"><%= time_ago_in_words(r.retracted_at) %> ago<% if tombstone %> · <%= tombstone.principal.name %><% end %></td>
        <td><%= tombstone&.reason %></td>
        <td class="actions">
          <%= form_with url: admin_restore_record_path(r), class: "inline" do |f| %>
            <%= f.button "Restore", class: "primary" %>
          <% end %>
          <%= form_with url: admin_purge_record_path(r), class: "inline" do |f| %>
            <%= f.button "Purge", class: "danger", onclick: "return confirm('Purge #{j r.ref} and every version of it, for good?')" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
</div>
