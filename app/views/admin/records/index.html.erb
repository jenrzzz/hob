<h1>Records</h1>
<p class="muted">What the household's agents keep (RECORDS.md). A retraction hides; only a purge here removes.</p>

<section class="card">
  <% if @collections.empty? %>
    <p class="muted">No collections yet.</p>
  <% else %>
    <div class="table-wrap">
      <table>
        <tr><th>Collection</th><th>Realm</th><th>Owner</th><th>Key</th><th>Schema</th><th>Records</th><th>Last write</th><th></th></tr>
        <% @collections.each do |c| %>
          <tr>
            <td><%= link_to c.name, admin_records_collection_path(c.name) %><% if c.proposed_by %> <span class="muted">· asked for by <%= c.proposed_by.name %></span><% end %></td>
            <td><%= c.realm %></td>
            <td><%= c.principal.name %></td>
            <td><code><%= c.key_path %></code></td>
            <td>v<%= c.schema_version %><% unless c.schema %> <span class="muted">(none)</span><% end %></td>
            <td><%= @counts[c.id] || 0 %></td>
            <td><% if (at = @last[c.id]) %><span title="<%= at.utc.iso8601 %>"><%= time_ago_in_words(at) %> ago</span><% else %>—<% end %></td>
            <td class="actions">
              <% if c.retracted? %>
                <span class="tag">retracted<% if c.retracted_by %> by <%= c.retracted_by.name %><% end %></span>
                <%= button_to "Restore", admin_restore_records_collection_path(c.name), class: "primary", form_class: "inline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  <% end %>
</section>

<% if @retracted.any? %>
  <h1 style="margin-top: 32px">Retracted records</h1>
  <section class="card">
    <%= render "retracted", records: @retracted %>
  </section>
<% end %>
