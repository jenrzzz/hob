<%# A request held for a person: what it asks, and the decide form. %>
<section class="card" id="request-<%= r.id %>">
  <div class="card-head">
    <h2><%= r.principal.name %> asks for <code><%= r.capability.name %></code></h2>
    <%= link_to "request #{r.id}", admin_sentinel_request_path(r), class: "tag" %>
    <span class="tag"><%= r.realm %></span>
    <span class="muted" title="<%= r.created_at.utc.iso8601 %>"><%= time_ago_in_words(r.created_at) %> ago</span>
  </div>
  <dl class="facts">
    <% if r.reason.present? %><dt>Reason</dt><dd><%= r.reason %></dd><% end %>
    <% if r.rationale.present? %><dt>Held because</dt><dd><%= r.rationale %></dd><% end %>
    <% if r.on_mission_id %><dt>On mission</dt><dd><%= r.on_mission_id %></dd><% end %>
  </dl>
  <% if (records = records_context(r)) %>
    <%= render "records_context", request: r, context: records %>
  <% elsif (people = people_context(r)) %>
    <%= render "people_context", request: r, context: people %>
  <% elsif (ward_threat = ward_threat_context(r)) %>
    <%= render "ward_threat_context", request: r, context: ward_threat %>
  <% elsif (mail_send_files = mail_send_files_context(r)) %>
    <%= render "mail_send_files_context", request: r, context: mail_send_files %>
  <% else %>
    <pre><%= JSON.pretty_generate(r.arguments) %></pre>
  <% end %>
  <% if r.review.present? %>
    <details><summary>Reviewer's notes</summary><pre><%= JSON.pretty_generate(r.review) %></pre></details>
  <% end %>
  <%= form_with url: admin_decide_sentinel_request_path(r), class: "row" do |f| %>
    <%= f.text_field :rationale, placeholder: "why (optional)", "aria-label": "Rationale" %>
    <%= f.button "Allow", name: "decision", value: "allow", class: "primary" %>
    <%= f.button "Deny", name: "decision", value: "deny", class: "danger" %>
    <% if r.authorization_claim&.spot_checked? %>
      <%= f.button "I never said that", name: "decision", value: "deny", class: "danger",
            formaction: admin_decide_sentinel_request_path(r, fabricated: 1),
            title: "Deny, and say #{r.principal.name} made up the quote: its capabilities freeze until someone unfreezes it" %>
    <% end %>
  <% end %>
</section>
