<h1>Waiting on you</h1>

<% if @requests.empty? && @petitions.empty? %>
  <p class="muted">Nothing is waiting.</p>
<% end %>

<% @requests.each do |r| %>
  <%= render "request", r: r %>
<% end %>

<% @petitions.each do |p| %>
  <%= render "petition", p: p %>
<% end %>

<h1 style="margin-top: 32px" id="history">History</h1>
<%= form_with url: admin_sentinel_path(anchor: "history"), method: :get, class: "row", style: "margin-bottom: 12px" do %>
  <%= select_tag :kind, options_for_select([ [ "Requests and petitions", "" ], [ "Requests", "requests" ], [ "Petitions", "petitions" ] ], params[:kind]), "aria-label": "Kind" %>
  <%= select_tag :agent, options_for_select([ [ "All agents", "" ] ] + @history_agents, params[:agent]), "aria-label": "Agent" %>
  <%= select_tag :capability, options_for_select([ [ "All capabilities", "" ] ] + @history_capabilities, params[:capability]), "aria-label": "Capability" %>
  <%= select_tag :status, options_for_select([ [ "Any status", "" ] ] + @history_statuses, params[:status]), "aria-label": "Status" %>
  <button type="submit">Filter</button>
  <% if history_filters.any? || params[:before].present? %><%= link_to "Clear", admin_sentinel_path(anchor: "history") %><% end %>
<% end %>
<% if params[:before].present? %>
  <p class="muted">Showing older rows. <%= link_to "Back to the newest", admin_sentinel_path(history_filters.merge(anchor: "history")) %></p>
<% end %>
<section class="card">
  <% if @history.empty? %>
    <p class="muted">Nothing matches.</p>
  <% else %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>When</th><th>Agent</th><th>Asked</th><th>Outcome</th><th>By</th></tr></thead>
        <tbody id="history-rows"><%= render "history_rows" %></tbody>
      </table>
    </div>
  <% end %>
  <%= render "history_more" %>
</section>

<script>
  // Infinite scroll: when the "Older" link nears the viewport, fetch the
  // next page's rows and append them. Without script the link still pages.
  (() => {
    const more = document.getElementById("history-more");
    const body = document.getElementById("history-rows");
    if (!more || !body || !("IntersectionObserver" in window)) return;
    let loading = false;
    const near = () => more.getBoundingClientRect().top < window.innerHeight + 400;
    const load = async () => {
      const link = more.querySelector("a[data-next]");
      if (!link || loading) return;
      loading = true;
      try {
        const url = new URL(link.href);
        url.hash = "";
        url.searchParams.set("rows", "1");
        const res = await fetch(url, { credentials: "same-origin", headers: { Accept: "text/html" } });
        if (!res.ok) throw new Error(res.status);
        const tpl = document.createElement("template");
        tpl.innerHTML = await res.text();
        tpl.content.querySelectorAll("tbody tr").forEach((tr) => body.appendChild(tr));
        const next = tpl.content.getElementById("history-more");
        more.replaceChildren(...(next ? next.childNodes : []));
      } catch (e) {
        loading = false;
        return; // leave the link for a click
      }
      loading = false;
      if (near()) load();
    };
    new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) load(); }, { rootMargin: "400px" }).observe(more);
  })();
</script>
