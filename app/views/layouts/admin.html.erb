<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>hob admin</title>
  <%= csrf_meta_tags %>
  <style>
    :root {
      --bg: #faf8f5; --panel: #ffffff; --ink: #1d1b18; --muted: #6b665e; --line: #e4dfd7;
      --accent: #7a4b1f; --accent-ink: #ffffff; --danger: #a2321f; --ok-bg: #eef5ea; --bad-bg: #fbecea; --code: #f3efe8;
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #171614; --panel: #201e1b; --ink: #ece7df; --muted: #a39c91; --line: #34302b;
        --accent: #d69a5c; --accent-ink: #1a1510; --danger: #e5826f; --ok-bg: #1f2a1c; --bad-bg: #321d19; --code: #2a2723;
        color-scheme: dark;
      }
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif; }
    header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
    header nav { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px; }
    header nav a { color: var(--muted); text-decoration: none; }
    header nav a.current, header a.brand { color: var(--ink); }
    header a.brand { font-weight: 650; }
    .badge { display: inline-block; min-width: 18px; padding: 0 5px; border-radius: 99px; background: var(--accent); color: var(--accent-ink); font-size: 12px; text-align: center; }
    pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; background: var(--code); border-radius: 6px; padding: 8px 10px; overflow-x: auto; margin: 6px 0; white-space: pre-wrap; word-break: break-word; }
    dl.facts { display: grid; grid-template-columns: max-content 1fr; gap: 2px 12px; margin: 6px 0; font-size: 14px; }
    dl.facts dt { color: var(--muted); }
    dl.facts dd { margin: 0; min-width: 0; }
    details summary { cursor: pointer; color: var(--muted); font-size: 14px; }
    main { max-width: 960px; margin: 0 auto; padding: 20px 16px 64px; }
    h1 { font-size: 20px; margin: 0 0 16px; }
    h2 { font-size: 16px; margin: 0; }
    a { color: var(--accent); }
    .muted { color: var(--muted); }
    .flash { padding: 10px 12px; border-radius: 8px; margin-bottom: 16px; }
    .flash.notice { background: var(--ok-bg); }
    .flash.alert { background: var(--bad-bg); }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; }
    .card-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin-bottom: 8px; }
    .tag { font-size: 12px; padding: 1px 7px; border-radius: 99px; border: 1px solid var(--line); color: var(--muted); }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 6px 8px 6px 0; border-top: 1px solid var(--line); vertical-align: middle; white-space: nowrap; }
    th { font-weight: 550; color: var(--muted); border-top: 0; }
    td.actions { text-align: right; }
    form.inline { display: inline; }
    form.row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 10px; }
    input, select, button { font: inherit; color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 7px; padding: 5px 9px; }
    input[type=text] { min-width: 0; flex: 1 1 140px; }
    button { cursor: pointer; }
    button.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
    button.danger { color: var(--danger); }
    button.link { background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; }
    code, .token { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--code); border-radius: 5px; padding: 1px 5px; }
    .token { display: block; padding: 12px; font-size: 14px; word-break: break-all; user-select: all; margin: 12px 0; }
  </style>
</head>
<body>
  <header>
    <nav>
      <a class="brand" href="<%= current_person ? admin_root_path : login_path %>">hob admin</a>
      <% if current_person %>
        <%= link_to "Keys", admin_root_path, class: ("current" if current_page?(admin_root_path)) %>
        <%= link_to admin_sentinel_path, class: ("current" if current_page?(admin_sentinel_path)) do %>Sentinel<% if (waiting = SentinelRequest.pending.count + Petition.where(status: %w[pending failed]).count).positive? %> <span class="badge"><%= waiting %></span><% end %><% end %>
        <%= link_to "Grants", admin_grants_path, class: ("current" if controller_name == "grants") %>
        <%= link_to "Gofer keys", admin_gofer_keys_path, class: ("current" if controller_name == "gofer_keys") %>
      <% end %>
    </nav>
    <% if current_person %>
      <span class="muted"><%= current_person.name %> ·
        <%= button_to "Sign out", logout_path, class: "link", form_class: "inline" %></span>
    <% end %>
  </header>
  <main>
    <% flash.each do |kind, message| %>
      <div class="flash <%= kind %>"><%= message %></div>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>
